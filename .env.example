# Copy to .env.local. Credentials are server-side; never prefix them with VITE_.
# This is the canonical list of experimental runtime controls. Restart after edits.

# Jev
TYPESAFE_API_KEY=
# Non-empty model name; no surrounding whitespace.
JEV_MODEL=jev-latest
# Integer milliseconds: 100–60000. Cue freshness/drain guards remain unchanged.
JEV_TIMEOUT_MS=5000

# Speechmatics Voice — read by the Python gateway (npm run voice).
# Server only; never prefix with VITE_.
SPEECHMATICS_API_KEY=
# Exactly captions or scribe; selects the official SDK preset.
SPEECHMATICS_VOICE_PRESET=scribe

# Optional, non-blocking OpenAI Cue Presentation V1. Server only; never use VITE_.
OPENAI_API_KEY=
# Non-empty model name; no surrounding whitespace. Luna uses reasoning effort none.
# Overrides keep their own defaults and are not sent Luna-specific parameters.
OPENAI_REFINEMENT_MODEL=gpt-5.6-luna
# Integer milliseconds: 100–60000. Server owns the attempt deadline; no retries.
OPENAI_REFINEMENT_TIMEOUT_MS=6000
# Exactly true or false. Unavailable without OPENAI_API_KEY regardless of this value.
OPENAI_REFINEMENT_ENABLED_DEFAULT=false
# Integer characters: 1–32000, source text plus reference context. No truncation.
OPENAI_REFINEMENT_MAX_INPUT_CHARS=16000

# Jev always uses structured-v3; language cmn_en and enhanced stay in code.
