# Copy to .env.local and set your TypeSafe API key. Never prefix this with VITE_.
TYPESAFE_API_KEY=
# Optional model override; the default is jev-latest.
JEV_MODEL=jev-latest

# Optional microphone input. Read by the Python Voice gateway (npm run voice).
# Server only; never prefix with VITE_.
SPEECHMATICS_API_KEY=

# Optional, non-blocking text refinement. Server only; never prefix with VITE_.
OPENAI_API_KEY=

# Jev always uses structured-v3; no context selection is needed.
